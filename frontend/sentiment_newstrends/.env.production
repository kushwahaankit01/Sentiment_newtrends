# Replace the value below with your actual HuggingFace Space URL
# Format: https://{your-hf-username}-{space-name}.hf.space
VITE_BACKEND_URL=https://YOUR_HF_USERNAME-aura-sentiment-backend.hf.space

# WebSocket URL (same host, different protocol)
# Format: wss://{your-hf-username}-{space-name}.hf.space/ws/webcam
VITE_WS_URL=wss://YOUR_HF_USERNAME-aura-sentiment-backend.hf.space/ws/webcam
